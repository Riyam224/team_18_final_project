 
class MarketCoin {
  final String name;
  final int rank;
  final double price;
  final double changePercentage;
  final String? iconPath;
  final Color accentColor;
  final Color badgeColor;

  const MarketCoin({
    required this.name,
    required this.rank,
    required this.price,
    required this.changePercentage,
    required this.iconPath,
    required this.accentColor,
    required this.badgeColor,
  });
}
